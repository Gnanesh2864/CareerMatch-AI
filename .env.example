# App Configuration
APP_NAME=CareerMatch AI
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
SECRET_KEY=careermatch-ai-super-secret-production-key-change-in-prod-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# In Docker: postgresql+asyncpg://postgres:postgres@db:5432/careermatch
# For local zero-config: sqlite+aiosqlite:///./careermatch.db (or fallback SQLite engine)
DATABASE_URL=sqlite:///./careermatch.db

# Embedding Model Configuration
# sentence-transformers/all-MiniLM-L6-v2 runs locally on CPU/Metal with zero API cost
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# LLM Providers (Optional - platform includes robust grounded offline synthesis engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Security & Uploads
MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_UPLOAD_EXTENSIONS=["pdf", "txt", "docx"]
